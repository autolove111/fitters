generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalType {
  DAILY_WORKOUT_MINUTES
  DAILY_SLEEP_HOURS
  DAILY_DIET_CALORIES
}

enum GoalPeriod {
  DAILY
}

model User {
  id           Int             @id @default(autoincrement())
  account      String          @unique @db.VarChar(64)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  nickname     String?         @db.VarChar(64)
  avatar       String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  workouts     WorkoutRecord[]
  goals        Goal[]
  sleeps       SleepRecord[]
  dietRecords  DietRecord[]
  workRecords  WorkRecord[]

  @@map("users")
}

model WorkoutRecord {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  type            String   @db.VarChar(64)
  durationMinutes Int      @map("duration_min")
  calories        Int      @default(0)
  recordDate      DateTime @map("record_date") @db.Date
  notes           String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate], map: "idx_workout_records_user_record_date")
  @@map("workout_records")
}

model Goal {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  goalType    GoalType   @map("goal_type")
  targetValue Int        @map("target_value")
  period      GoalPeriod @default(DAILY)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, goalType, period], map: "uq_goals_user_type_period")
  @@map("goals")
}

model SleepRecord {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  recordDate    DateTime @default(now()) @map("record_date") @db.Date
  durationHours Decimal? @map("duration_hours") @db.Decimal(4, 2)
  deepHours     Decimal? @map("deep_hours") @db.Decimal(4, 2)
  sleepTime     DateTime @map("bed_time")
  wakeTime      DateTime @map("wake_time")
  quality       Int      @default(0) @map("quality_score")
  notes         String?  @db.VarChar(255)
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate], map: "idx_sleep_records_user_record_date")
  @@map("sleep_records")
}

model DietRecord {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  recordDate    DateTime  @map("record_date") @db.Date
  mealType      String    @map("meal_type") @db.VarChar(32)
  foodName      String    @map("food_name") @db.VarChar(128)
  quantityGrams Decimal?  @map("quantity_grams") @db.Decimal(8, 2)
  calories      Int       @default(0)
  proteinGrams  Decimal?  @map("protein_grams") @db.Decimal(6, 2)
  fatGrams      Decimal?  @map("fat_grams") @db.Decimal(6, 2)
  carbGrams     Decimal?  @map("carb_grams") @db.Decimal(6, 2)
  notes         String?   @db.VarChar(255)
  metadata      Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate], map: "idx_diet_records_user_record_date")
  @@index([userId, mealType, recordDate], map: "idx_diet_records_user_meal_date")
  @@map("diet_records")
}

model WorkRecord {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  recordType            String    @map("record_type") @db.VarChar(32)
  recordDate            DateTime  @map("record_date") @db.Date
  occupation            String?   @db.VarChar(64)
  pomodoroDuration      Int?      @map("pomodoro_duration")
  sedentaryReminderOn   Boolean?  @map("sedentary_reminder_on")
  sedentaryInterval     Int?      @map("sedentary_interval")
  wristHealthScore      Int?      @map("wrist_health_score")
  eyeRestCount          Int?      @map("eye_rest_count")
  waterIntake           Int?      @map("water_intake")
  backRelaxCount        Int?      @map("back_relax_count")
  vocalRestCount        Int?      @map("vocal_rest_count")
  stopMoveCount         Int?      @map("stop_move_count")
  eyeExerciseCount      Int?      @map("eye_exercise_count")
  classBreakCount       Int?      @map("class_break_count")
  deepBreathCount       Int?      @map("deep_breath_count")
  legMoveCount          Int?      @map("leg_move_count")
  neckRelaxCount        Int?      @map("neck_relax_count")
  stepCount             Int?      @map("step_count")
  energySnackCount       Int?      @map("energy_snack_count")
  standCount            Int?      @map("stand_count")
  sessionType           String?   @map("session_type") @db.VarChar(32)
  sessionStart          DateTime? @map("session_start")
  sessionEnd            DateTime? @map("session_end")
  sessionDuration       Int?      @map("session_duration")
  todoContent           String?   @map("todo_content") @db.VarChar(255)
  todoCompleted         Boolean?  @map("todo_completed")
  sedentaryRespondedAt  DateTime? @map("sedentary_responded_at")
  notes                 String?   @db.VarChar(255)
  metadata              Json?     @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate], map: "idx_work_records_user_record_date")
  @@index([userId, recordType, recordDate], map: "idx_work_records_user_type_date")
  @@map("work_records")
}
