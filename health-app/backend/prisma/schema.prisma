generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalType {
  DAILY_WORKOUT_MINUTES
  DAILY_SLEEP_HOURS
  DAILY_DIET_CALORIES
}

enum GoalPeriod {
  DAILY
}

enum MembershipTier {
  FREE
  PRO
}

model User {
  id           Int             @id @default(autoincrement())
  account      String          @unique @db.VarChar(64)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  nickname     String?         @db.VarChar(64)
  avatar       String?         @db.Text
  theme        String          @default("light") @db.VarChar(16)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  workouts     WorkoutRecord[]
  goals        Goal[]
  sleeps       SleepRecord[]
  diets        DietRecord[]
  workRecords  WorkRecord[]
  fitnessProfile UserFitnessProfile?
  subscription UserSubscription?
  aiPlanHistories AiPlanHistory[]
  waterRecords WaterRecord[]
  weightRecords WeightRecord[]
  studyPlans   StudyPlan[]

  @@map("users")
}

model UserFitnessProfile {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique @map("user_id")
  age                  Int?
  heightCm             Int?     @map("height_cm")
  weightKg             Decimal? @map("weight_kg") @db.Decimal(6, 2)
  goal                 String   @default("general_fitness") @db.VarChar(64)
  fitnessLevel         String   @default("beginner") @map("fitness_level") @db.VarChar(32)
  injuries             String?  @db.VarChar(255)
  equipment            Json?    @db.JsonB
  preferredWorkoutTime String?  @map("preferred_workout_time") @db.VarChar(32)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_fitness_profiles")
}

model UserSubscription {
  id                 Int            @id @default(autoincrement())
  userId             Int            @unique @map("user_id")
  tier               MembershipTier @default(FREE)
  dailyAiQuota       Int            @default(3) @map("daily_ai_quota")
  usedAiQuota        Int            @default(0) @map("used_ai_quota")
  quotaDate          DateTime       @default(now()) @map("quota_date") @db.Date
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model AiPlanHistory {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  membershipTier MembershipTier @default(FREE) @map("membership_tier")
  planType       String         @default("personalized_workout") @map("plan_type") @db.VarChar(64)
  request        Json           @db.JsonB
  response       Json           @db.JsonB
  citations      Json?          @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_ai_plan_histories_user_created")
  @@map("ai_plan_histories")
}

model WorkoutRecord {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  type            String   @db.VarChar(64)
  durationMinutes Int      @map("duration_min")
  calories        Int      @default(0)
  steps           Int?
  sourceType      String   @default("MANUAL") @map("source_type") @db.VarChar(32)
  recordDate      DateTime @map("record_date") @db.Date
  notes           String?  @db.VarChar(255)
  metadata        Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate], map: "idx_workout_records_user_record_date")
  @@map("workout_records")
}

model Goal {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  goalType    GoalType   @map("goal_type")
  targetValue Int        @map("target_value")
  period      GoalPeriod @default(DAILY)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, goalType, period], map: "uq_goals_user_type_period")
  @@map("goals")
}

model SleepRecord {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  recordDate    DateTime @default(now()) @map("record_date") @db.Date
  durationHours Decimal? @map("duration_hours") @db.Decimal(4, 2)
  deepHours     Decimal? @map("deep_hours") @db.Decimal(4, 2)
  sleepTime     DateTime @map("bed_time")
  wakeTime      DateTime @map("wake_time")
  quality       Int      @default(0) @map("quality_score")
  sourceType    String   @default("MANUAL") @map("source_type") @db.VarChar(32)
  notes         String?  @db.VarChar(255)
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate], map: "idx_sleep_records_user_record_date")
  @@map("sleep_records")
}

model DietRecord {
  id             Int          @id @default(autoincrement())
  userId         Int?         @map("user_id")
  recordType     String       @default("diet") @map("record_type") @db.VarChar(32)
  type           String       @default("meal") @db.VarChar(64)
  calories       Int          @default(0)
  recordDate     DateTime     @map("record_date") @db.Date
  notes          String?      @db.VarChar(255)
  parentRecordId Int?         @map("parent_record_id")
  foodName       String?      @map("food_name") @db.VarChar(128)
  mealType       String?      @map("meal_type") @db.VarChar(32)
  quantityGrams  Decimal?     @map("quantity_grams") @db.Decimal(8, 2)
  proteinGrams   Decimal?     @map("protein_grams") @db.Decimal(6, 2)
  fatGrams       Decimal?     @map("fat_grams") @db.Decimal(6, 2)
  carbGrams      Decimal?     @map("carb_grams") @db.Decimal(6, 2)
  amountMl       Int?         @map("amount_ml")
  weightKg       Decimal?     @map("weight_kg") @db.Decimal(6, 2)
  sourceType     String       @default("MANUAL") @map("source_type") @db.VarChar(32)
  metadata       Json?        @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         DietRecord?  @relation("DietRecordChildren", fields: [parentRecordId], references: [id], onDelete: Cascade)
  children       DietRecord[] @relation("DietRecordChildren")

  @@index([userId, recordDate], map: "idx_diet_records_user_record_date")
  @@index([recordType], map: "idx_diet_records_record_type")
  @@index([parentRecordId], map: "idx_diet_records_parent_record_id")
  @@map("diet_records")
}

model WorkRecord {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  recordType      String   @map("record_type") @db.VarChar(32)
  type            String?  @db.VarChar(32)
  recordDate      DateTime @default(now()) @map("record_date") @db.Date
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  durationMinutes Int?     @default(0) @map("duration_minutes")
  content         String?  @db.VarChar(255)
  deadline        DateTime?
  completed       Boolean  @default(false)
  settings        Json?    @db.JsonB
  metadata        Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordType, recordDate], map: "idx_work_records_user_type_date")
  @@index([userId, startTime], map: "idx_work_records_user_start")
  @@map("work_records")
}

model WaterRecord {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  recordDate      DateTime @default(now()) @map("record_date") @db.Date
  amountMl        Int      @map("amount_ml")
  notes           String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate], map: "idx_water_records_user_record_date")
  @@map("water_records")
}

model WeightRecord {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  recordDate      DateTime @default(now()) @map("record_date") @db.Date
  weightKg        Decimal  @map("weight_kg") @db.Decimal(6, 2)
  notes           String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate], map: "idx_weight_records_user_record_date")
  @@map("weight_records")
}

model StudyPlan {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  content   String   @db.VarChar(500)
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  status    String   @default("pending") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_study_plans_user_id")
  @@map("study_plans")
}
