{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": { "navigationBarTitleText": "Fitters健康管家" }
    },
    {
      "path": "pages/register/register",
      "style": {
        "navigationBarTitleText": "注册",
        "navigationBarBackgroundColor": "#ffffff"
      }
    },
    {
      "path": "pages/workout/workout",
      "style": {
        "navigationBarTitleText": "健身运动",
        "navigationBarBackgroundColor": "#ffffff",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/weightloss/weightloss",
      "style": {
        "navigationBarTitleText": "减肥助手",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/wellness/wellness",
      "style": {
        "navigationBarTitleText": "养生"
      }
    },
    {
      "path": "pages/wellness/checkin-report",
      "style": {
        "navigationBarTitleText": "月度养生报告",
        "navigationBarBackgroundColor": "#ffffff"
      }
    },
    {
      "path": "pages/workout/add",
      "style": { "navigationBarTitleText": "添加运动记录" }
    },
    {
      "path": "pages/sleep/add",
      "style": { "navigationBarTitleText": "添加睡眠记录" }
    },
    {
      "path": "pages/diet/add",
      "style": { "navigationBarTitleText": "添加饮食记录" }
    },
    {
      "path": "pages/work/work",
      "style": {
        "navigationBarTitleText": "工作健康助手"
      }
    },
    {
      "path": "pages/work/exercise-detail",
      "style": {
        "navigationBarTitleText": "微运动详情"
      }
    },
    {
      "path": "pages/work/occupation-select",
      "style": {
        "navigationBarTitleText": "选择职业",
        "navigationBarBackgroundColor": "#ffffff"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "Fitters",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}